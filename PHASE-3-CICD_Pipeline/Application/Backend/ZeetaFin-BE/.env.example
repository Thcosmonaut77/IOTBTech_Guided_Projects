PORT=3001
DB_HOST=zeetafin-db
DB_PORT=5432
DB_USERNAME=<database_username>
DB_PASSWORD=<database_password>
DB_NAME=<database_name>
JWT_SECRET=change-this-to-a-random-secret
NODE_ENV=production
DB_LOGGING=false

# Schema changes are applied by migrations (node dist/migrate.js) at container
# start. TypeORM synchronize is disabled in every environment.